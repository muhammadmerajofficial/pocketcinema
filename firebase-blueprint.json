{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered user profile and authentication sync",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "description": "User profile photo URL"
        },
        "provider": {
          "type": "string",
          "description": "Authentication provider"
        },
        "createdAt": {
          "type": "string",
          "description": "Account creation timestamp"
        },
        "lastLoginAt": {
          "type": "string",
          "description": "Last sign-in timestamp"
        }
      },
      "required": ["uid", "email"]
    },
    "RemoteSession": {
      "title": "Remote Session",
      "description": "Real-time pairing and synchronization session between main remote and display",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "6-character unique pairing code"
        },
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner"
        },
        "userEmail": {
          "type": "string",
          "description": "User Gmail address"
        },
        "userDisplayName": {
          "type": "string",
          "description": "User display name"
        },
        "currentItem": {
          "type": "object",
          "description": "Currently selected media item"
        },
        "playingItem": {
          "type": "object",
          "description": "Currently playing media item or null"
        },
        "activeCategory": {
          "type": "string",
          "description": "Active category type"
        },
        "searchQuery": {
          "type": "string",
          "description": "Active search query"
        },
        "selectedIndex": {
          "type": "number",
          "description": "Selected item index"
        },
        "isQuickConnect": {
          "type": "boolean",
          "description": "True if this is the default same-network quick connect session (gotocinema)"
        },
        "networkIp": {
          "type": "string",
          "description": "Public IP/Network identifier for same-network verification"
        },
        "displayActive": {
          "type": "boolean",
          "description": "Whether the Remote Display window is currently open"
        },
        "displaySessionId": {
          "type": "string",
          "description": "Unique session ID for the active display window instance"
        },
        "displayLastHeartbeat": {
          "type": "number",
          "description": "Timestamp of last heartbeat from display window"
        },
        "connectedRemoteId": {
          "type": "string",
          "description": "Device ID of currently connected remote controller"
        },
        "connectedRemoteName": {
          "type": "string",
          "description": "Device name or description of connected remote"
        },
        "remoteLastHeartbeat": {
          "type": "number",
          "description": "Timestamp of last heartbeat from connected remote controller"
        },
        "remoteConnectedAt": {
          "type": "number",
          "description": "Timestamp when remote controller connected"
        },
        "disconnectedAt": {
          "type": "string",
          "description": "Timestamp when session or remote was disconnected"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        },
        "createdAt": {
          "type": "string",
          "description": "Session creation timestamp"
        }
      },
      "required": ["code", "userId", "userEmail"]
    },
    "Room": {
      "title": "TV Player Room",
      "description": "Direct 4-digit room channel for TV player and remote control pairing",
      "type": "object",
      "properties": {
        "roomCode": {
          "type": "string",
          "description": "4-digit numeric room code"
        },
        "status": {
          "type": "string",
          "description": "Room status: waiting, connected, or closed"
        },
        "action": {
          "type": "string",
          "description": "Last playback action command"
        },
        "isPlaying": {
          "type": "boolean",
          "description": "Current play/pause state"
        },
        "currentTime": {
          "type": "number",
          "description": "Current playback position in seconds"
        },
        "volume": {
          "type": "number",
          "description": "Current volume level"
        },
        "serverIndex": {
          "type": "number",
          "description": "Active video stream server index"
        },
        "season": {
          "type": "number",
          "description": "Active season number"
        },
        "episode": {
          "type": "number",
          "description": "Active episode number"
        },
        "lastCommandTimestamp": {
          "type": "number",
          "description": "Timestamp of latest command"
        }
      },
      "required": ["roomCode", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document accessible by the authenticated user"
    },
    "/remote_sessions/{sessionCode}": {
      "schema": "RemoteSession",
      "description": "Live remote sync session pairing document keyed by 6-digit code"
    },
    "/rooms/{roomCode}": {
      "schema": "Room",
      "description": "Direct 4-digit room channel for TV player and remote control pairing"
    }
  }
}
